<!DOCTYPE html>
<html>
<head>
  <title>My Ice Cream Shop Menu</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #fff4f8;
      text-align: center;
      color: #4a2c2a;
    }
    h1 {
      color: #88d5b5;
      font-size: 36px;
    }
    h1 + p {
      color: #5ae2b7;
      font-weight: bold;
      background-color: #e3fff6;
      border-radius: 10px;
    }
    .shop-description::first-letter {
      font-size: 36px;
      color: #62dca5;
      font-weight: bold;
    }
    .menu-box {
      width: 420px;
      background-color: white;
      border: 3px solid #419169;
      border-radius: 15px;
      margin: 20px auto;
      padding: 20px;
    }
    ul {
      padding: 0;
    }
    ul > li {
      list-style: none;
      background-color: #fff0f5;
      color: #50c296;
      font-size: 18px;
      font-weight: bold;
      margin: 10px;
      padding: 12px;
      border-radius: 10px;
      border: 2px solid #073c23;
    }
    ul > li:nth-child(3) {
      background-color: #cdffe4;
      color: #66b894;
      border: 3px solid #3e8e76;
    }
    ul > li:hover {
      background-color: #8fe390;
      color: white;
      cursor: pointer;
      transform: scale(1.05);
    }
    button {
      background-color: #33d6aa;
      color: white;
      border: none;
      border-radius: 20px;
      padding: 12px 24px;
      font-size: 16px;
      font-weight: bold;
    }
    button:hover {
      background-color: #26ad5c;
    }
  </style>
</head>
<body>
  <h1>My Ice Cream Shop Menu</h1>
  <p>Welcome to Scoops of Joy!</p>
  <p class="shop-description">
    We serve colourful, creamy, and delicious ice cream flavours.
  </p>
  <div class="menu-box">
    <h2>Today's Ice Cream Flavours</h2>
    <ul>
      <li>Chocolate Delight</li>
      <li>Strawberry Swirl</li>
      <li>Mango Magic - Today's Special</li>
      <li>Vanilla Dream</li>
      <li>Blueberry Blast</li>
    </ul>
    <button>Order Now</button>
  </div>
</body>
</html>