<!DOCTYPE html>
<html lang="en">
<head>
  <title>My zoo</title>

  <style>
    .body { 
        background: aliceblue;
        font-family: cursive;
        text-align: center;
        padding: 30px;
    }

    h1 {
        color: teal;
    }

    #zoo {
        border: 5px;
        width: 350px;
        margin: auto;
        padding: 15px;
        border-radius: 15px;
        background-color: white;
    }

    .zone {
        border: 3px dashed darkcyan;
        margin: 10px;
        padding: 10px 15px;
        border-radius: 5px;
        text-align: left;
    }

    button {
        background: rgb(104, 104, 201);
        color: whitesmoke;
        padding: 10px 25px;
        border: none;
        border-radius: 20px;
        cursor: pointer;
    }
    </style>
</head>

<body>

    <h1>my zoo</h1>
    <p>use js and the dom to add animals to each zone</p>

    <div id="zoo">
    <div class="zone">zone 1: <span id="zone1"></span></div>
    <div class="zone">zone 2: <span id="zone2"></span></div>
    <div class="zone">zone 3: <span id="zone3"></span></div>
    <div class="zone">total animals: <span id="total"></span></div>
    </div>

    <br>

    <button onclick="openzoo()">open the zoo!!!</button>

    <p id="zoo-status"></p>

    <script>

        function openzoo(){

        document.getElementById("zone1").innerHTML = "turtle";
        document.getElementById("zone2").innerHTML = "dolphin";
        document.getElementById("zone3").innerHTML = "penguin";
        document.getElementById("total").innerHTML = "3";
        document.getElementById("zoo").style.backgroundColor = "lightblue";
        document.getElementById("zoo-status").innerHTML = document.title + " is now open"

        }
        </script>
</body>
</html>