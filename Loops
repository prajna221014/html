<!DOCTYPE html>
<html>

<body>
    <h2>js for loop</h2>
    <p id="demo"></p>
    <script>
        var fruits = ["watermelon", "strawberry", "cherry", "mango", "kiwi", "cheeku"];
        var fru = "";
        var i;

        for (i = 0; i < fruits.length;i++)
    {
        fru += fruits[i] + "<br>";
    }

    document.getElementById("demo").innerHTML = fru;
    </script>
</body>
</html>