<!DOCTYPE html>
<html lang="en">
<head>
  <title>My Planet Explorer</title>
  <link 
  rel="stylesheet" 
  href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">

  <style>
  
  body {
         background-color: lightblue; 
        }

        h1,
        h3 {
            color: teal;
        }

        .box {
            background: white;
            color: rgb(0, 139, 139);
        }
        </style>
</head>
<body>
     <div class="container py-4">
        <h1 class="mb-1">my magic word app</h1>
        <p class="text-muted mb-4">
            discover a new world of coding with js!
        </p>

        <div class="card mb-4">
            <div class="card-body">
                <h3 class="card-title">what type is it?</h3>
                <button class="btn btn-primary" onclick="checkTypes()">
                    reveal the types!
                </button>
                <div id="typeResult" class="box p-3 mt-3 rounded">
                </div>
            </div>
        </div>

         <div class="card mb-4">
            <div class="card-body">
                <h3 class="card-title">switch the type.</h3>
                <input
                id="numIn"
                class="form-controll mb-2"
                placeholder="type any number here (eg:67)"
                />
                <button class="btn btn-primary" onclick="toStr()">
                    Turn into text!
                </button>
                <button class="btn btn-primary" onclick="toNum()">
                    Turn into number!
                </button>
                <div id="convResult" class="box p-3 mt-3 rounded">
                    type a number above then press the button
                </div>
            </div>
         </div>

          <div class="card mb-4">
            <div class="card-body">
                <h3 class="card-title">find and swap a word</h3>
                <input
                id="findW"
                class="form-controll mb-2"
                placeholder="try to find a word (eg: dragon)"
                />
                <input
                id="swapW"
                class="form-controll mb-2"
                placeholder="swap it with (eg: dinsaur)"
                />
                <button class="btn btn-primary" onclick="doSearch()">
                    Find it!
                </button>
                <button class="btn btn-primary" onclick="doReplace()">
                    Swap it!
                </button>
                <div id="srResult" class="box p-3 mt-3 rounded">
                     sentece: The enormous, ancient dragon that had 
                     slept beneath the mountains for thousands of
                     years suddenly awoke when the archaeologists 
                     accidentally disturbed its hidden cavern, 
                     causing the entire valley to tremble beneath the
                     weight of its thunderous footsteps.
                </div>
            </div>
         </div>

         <div class="card mb-4">
            <div class="card-body">
                <h3 class="card-title">catch the mistake</h3>
                <input
                id="divIn"
                class="form-controll mb-2"
                placeholder=" or type something silly"
                />
                <button class="btn btn-primary" onclick="trysafe()">
                    type something silly or you could play safe and
                     type a boring number of your choice!
                </button>
                <div id="errResult" class="box p-3 mt-3 rounded">
                </div>
            </div>
        </div>
     </div>
     <script>

        var sen = "The enormous, ancient dragon that had slept beneath the mountains for thousands of years suddenly awoke when the archaeologists accidentally disturbed its hidden cavern, causing the entire valley to tremble beneath the weight of its thunderous footsteps.";
        function checkTypes() {
            document.getElementById("typeResult").innerText = 
            "score 67          - type: " + typeof 67 + "\nName 'hiteshri'      - type: " +
            typeof "hiteshri" + "\n" + "game over true   - type: " + typeof true;
        }

        function toStr() {
            var v = document.getElementById("numIn").value;
            document.getElementById("convResult").innerHTML = 
            "String(" + v + ") = '" + String(v) + "' - now it is a: " + typeof String(v);
        }

        function toNum() {
            var v = document.getElementById("numIn").value;
            document.getElementById("convResult").innerHTML = 
            "Number(" + v + ") = '" + Number(v) + "' - now it is a: " + typeof Number(v);
        }

        function doSearch() {
            var w = document.getElementById("findW").value;
            var p = sen.search(w);
            document.getElementById("srResult").innerHTML = 
            p === -1
            ?"'" + w + "' is not in thesentence - try another word!"
            : "found '"+ w + "' hiding at position " + p + "!";
        }

        function doReplace() {
            var w = document.getElementById("findW").value;
            document.getElementById("srResult").innerHTML = 
            "new sentence: " +
            sen.replace(w, document.getElementById("swapW").value);
        }

        function trysafe() {
            try {
                var n = document.getElementById("divIn").value;
                if (n === "" || isNaN(n)) {
                    throw "That is not a number - u caught the error";
            }
            document.getElementById("errResult").innerHTML = 
            "100 / " + n + " = " + 100 / Number(n) + " - well done!";
            } catch (err) {
                document.getElementById("errResult").innerHTML = 
                "error caught: " + err;
            }
        }
        </script>
</body>
</html>