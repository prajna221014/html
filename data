<!DOCTYPE html>
<html>
<head>
  <title>data</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- STEP 1 - Bootstrap CSS link -->
  <link rel="stylesheet"
    href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">

  <style>
    body { background-image: linear-gradient(to bottom left, rgb(99, 90, 171), rgb(73, 137, 73), rgb(118, 118, 73)); }
    h1 { color: rgb(130, 121, 177);}
    .card-lable {font-size: 12px; color: rgb(232, 215, 215); text-transform: uppercase;}
    pre { font-size: 15px; color: black;}
    </style>
</head>
<body class="py-4">

    <div class="container">

        <h1 class="mb-1">My Phone Contact</h1>
        <p class="text-muted mb-4">
            intro to objects in jungle-slide
        </p>

        <div class="card shadow-sm mb-3" style="max-width: 400px;">
            <div class="card-body">
                <h5 class="card-title" style="color: rgb(15, 15, 88);">
                contact details</h5>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <span class="card-label d-block">school</span>
                        <strong id="company">-</strong>
                    </li>
                    <li class="list-group-item">
                        <span class="card-label d-block">phone</span>
                        <strong id="phone">-</strong>
                    </li>
                    <li class="list-group-item">
                        <span class="card-label d-block">city</span>
                        <strong id="city">-</strong>
                    </li>
                    <li class="list-group-item">
                        <span class="card-label d-block">name</span>
                        <strong id="name">-</strong>
                    </li>
                </ul>
            </div>
        </div>

        <div class="card-shadow-sm" style="max-width: 400px;">
        <div class="card-body">
            <h6 style="color: mediumseagreen;">JS Object used</h6>
            <pre id="codeDisplay"
            class="bg-light p-3 rounded border mb-0"></pre>
        </div>
        </div>
    
    </div>

    <script>

        var myContact = {
            name: "jungkook",
            phone: "0798773567",
            company: "HYBE",
            city: "Korean 전정국",
        }

     var nameEl  = document.getElementById("name");
     var phoneEl = document.getElementById("phone");
     nameEl.textContent  = myContact.name;
     phoneEl.textContent = myContact.phone;

     var companyEl = document.getElementById("company");
     var cityEl = document.getElementById("city");
     companyEl.textContent  = myContact["company"];
     cityEl.textContent = myContact["city"];

     var codeE1 = document.getElementById("codeDisplay")
     codeE1.textContent = 'var myContact = {\n' +
     'name; "' + myContact.name + '",\n' +
     'phone;' + myContact.phone + '",\n' +
     'company; "' + myContact.company + '",\n' +
     'city; "' + myContact.city + '",\n' +
     '};';

     </script>
</body>
</html>