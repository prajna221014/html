<!DOCTYPE html>
<html lang="en">
<head>
  <title>My Planet Explorer</title>
  <link 
  rel="stylesheet" 
  href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">

  <style>
  
  body {
         background-color: lightblue; 
        }

        h1,
        h3 {
            color: teal;
        }

        .box {
            background: white;
            color: rgb(0, 139, 139);
        }
        </style>
</head>
<body>
    <div class="container py-4">
        <div class="card-body">
            <h1 class="mb-1">my song sorter</h1>

            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">song names</h3>
                    <button class="btn btn-primary mr-2" onclick="sortAZ()">
                    sort A-Z 
                    </button>
                    <button class="btn btn-primary mr-2" onclick="sortZA()">
                    sort Z-A
                    </button>
                    <div id="nameResult" class="box p-3 mt-3 rounded"></div>
                </div>
            </div>
            
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">played most/least</h3>
                    <button class="btn btn-primary mr-2" onclick="sortLeast()">
                    most played first 
                    </button>
                    <button class="btn btn-primary mr-2" onclick="sortMost()">
                    least played first
                    </button>
                    <div id="countResult" class="box p-3 mt-3 rounded"></div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">song names</h3>
                    <button class="btn btn-primary mr-2" onclick="addLable()">
                    add plays lable 
                    </button>
                    <div id="lableResult" class="box p-3 mt-3 rounded"></div>
                </div>
            </div>
        </div>
        <script>
            var songs = ["gods menu", "thunderous", "megaverse", "case 143", "run it", "this & that","maniac"];
            var plays = [56832, 49562, 34975, 213456, 315824, 3155682, 32587999];

            document.getElementById("nameResults").innerHTML = "songs: " + songs;
            document.getElementById("countResults").innerHTML = "plays: " + plays;
            document.getElementById("lableResults").innerHTML = "press the button above!!!";

            function sortAZ() {
                songs.sort();
                document.getElementById("nameResults").innerHTML = "songs: " + songs;
             }

             function sortZA() {
                songs.sort();
                songs.reverse();
                document.getElementById("countResults").innerHTML = "songs: " + songs;
             }

             function sortLeast() {
                plays.sort(function (a, b) {
                    return a - b;
                });
                document.getElementById("countResults").innerHTML = "plays: " + plays;
             }  

             function sortMost() {
                plays.sort(function (a, b) {
                    return b - a;
                });
                document.getElementById("countResults").innerHTML = "plays: " + plays;
             }  