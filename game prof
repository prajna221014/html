<!DOCTYPE html>
<html lang="en">
<head>
  <title>My gameing profile</title>

  <style>
    .body { 
        background: rgb(54, 110, 159);
        font-family: cursive;
        text-align: center;
        padding: 30px;
    }

    h1 { color: rgb(41, 94, 139); }
    
    button {
        background: rgb(1, 5, 8);
        color: rgb(54, 110, 159);
        padding: 10px 25px;
        border: none;
        border-radius: 20px;
        cursor: pointer;
    }

    div {
        border: 1px dashed  rgb(54, 110, 159);
        width: 280px;
        margin: 6px auto;
        padding: 8px 12px;
        text-align: left;
        border-radius: 6px;
    }
</style>
</head>
<body>

    <h1>my game prof</h1>
    <button onclick="showprofile()">show profile</button>
    
    <div>name: <span id="name"></span></div>
    <div>score: <span id="score"></span></div>
    <div>top-score: <span id="top-score"></span></div>
    <div>rank: <span id="rank"></span></div>
    <div>greeting: <span id="greeting"></span></div>
    <div>stars: <span id="stars"></span></div>
    <div>bonus: <span id="bonus"></span></div>
    <div>team-name: <span id="team-name"></span></div>

    <script>

        function showprofile() {

            let name = "aashi";
            let myscore = 67;
            let highscore = 67;
            let bonus = null;
            let team;

        let istopscore = myscore == highscore;

        let rank;
        if (myscore >= 50) {
            rank = "gold";
        } else if (myscore >= 35) {
            rank = "silver";
        } else {
            rank = "bronze"
        }

        let hour = new Date().getHours();
        let greeting;
        if (hour < 12) {
            greeting = "good morning";
        } else if (hour > 17) {
            greeting = "good afternoon";
        } else {
            greeting = "good evening";
        }

        let stars = "";
        let count = 0;
        while (count < 3) {
            stars = stars + "* ";
            count = count + 1;
        }

        document.getElementById("name").innerHTML = name;
        document.getElementById("score").innerHTML = myscore + " out of " + highscore;
        document.getElementById("top-score").innerHTML = istopscore;
        document.getElementById("rank").innerHTML = rank;
        document.getElementById("greeting").innerHTML = greeting;
        document.getElementById("stars").innerHTML = stars;
        document.getElementById("bonus").innerHTML = bonus;
        document.getElementById("team-name").innerHTML = team;

    }

    </script>
</body>
</html>