<!DOCTYPE html>
<html lang="en">
<head>
  <title>student Dashboard</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">

  <style>
     body { 
    background-color: #f4fff4; 
    font-family: Arial, sans-serif; 
}
    
    .jumbotron { 
        background-color: #e6f9ec;
         border-left: 6px solid #42704b;
         }
   
    .jumbotron h1 { color: #7fc885; }
    
    .section-title { 
        color: #60ae73;
         margin-top: 30px;
          margin-bottom: 15px;
         }
   
    p { 
        font-weight: bold;
         margin-bottom: 5px;
         }
 
 </style>
</head>
<body>

  <div class="jumbotron jumbotron-fluid">
    <div class="container">
      <h1>My Study Progress Dashboard</h1>
      <p class="lead">Track your subjects, completed lessons, and learning progress in one place.</p>

      <button class="btn btn-primary">P.E</button>
      <button class="btn btn-success">Yoga</button>
      <button class="btn btn-warning">Art</button>
      <button class="btn btn-danger">Computing</button>
    </div>
  </div>

  <div class="container">

    <h2 class="section-title">Lessons Completed <span class="badge badge-danger">24</span></h2>
    <p>P.E <span class="badge badge-primary">8 lessons</span></p>
    <p>Yoga <span class="badge badge-success">6 lessons</span></p>
    <p>Art <span class="badge badge-warning">5 lessons</span></p>
    <p>Computing <span class="badge badge-info">5 lessons</span></p>

    <h2 class="section-title">Subject Progress</h2>

    <p>P.E</p>
    <div class="progress mb-3">
      <div class="progress-bar bg-primary" style="width: 90%">90%</div>
    </div>

    <p>Yoga</p>
    <div class="progress mb-3">
      <div class="progress-bar bg-success" style="width: 50%">50%</div>
    </div>

    <p>Art</p>
    <div class="progress mb-3">
      <div class="progress-bar bg-warning" style="width: 85%">85%</div>
    </div>

    <p>Computing</p>
    <div class="progress mb-3">
      <div class="progress-bar bg-danger" style="width: 67%">67%</div>
    </div>

  </div>

  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>